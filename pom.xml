<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.atari.raster</groupId>
	<artifactId>org.atari.raster.rmt</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>RASTER Music Tracker (Java port)</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
		<!-- CRmtApp::GetVersionAndBuild()'s __DATE__ __TIME__: written into the jar manifest as Build-Date. -->
		<maven.build.timestamp.format>yyyy-MM-dd HH:mm 'UTC'</maven.build.timestamp.format>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.wudsn.tools</groupId>
			<artifactId>com.wudsn.tools.base</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>com.wudsn.tools</groupId>
			<artifactId>com.wudsn.tools.base.atari</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- The documentation generator (org.atari.raster.rmt.doc.DocGenerator):
		     doc/*.md to the HTML the distributions ship - see
		     plans/23_DOC_GENERATION_PLAN.md. CommonMark's reference implementation
		     (BSD-2-Clause) plus GitHub-flavoured tables. -->
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
			<version>0.29.0</version>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark-ext-gfm-tables</artifactId>
			<version>0.29.0</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.8.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>rmt</finalName>
		<sourceDirectory>src/java</sourceDirectory>
		<testSourceDirectory>src/java/test</testSourceDirectory>
		<resources>
			<resource>
				<directory>src/java</directory>
				<excludes>
					<exclude>**/*.java</exclude>
					<exclude>test/**</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<!-- src/java/test lives *inside* src/java (mirroring src/cpp/test's
			     own nesting inside src/cpp), so the main compile must explicitly
			     exclude it - otherwise it compiles test sources without the
			     test-scoped JUnit dependency on the classpath. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>test/**</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
			</plugin>
			<!-- Merges this project's classes with com.wudsn.tools.base(.atari) into
			     a single runnable jar, target/rmt.jar (as dis6502 does). Run it from
			     the rmt/ layout (or a checkout root) - see ProgramFolder. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.3</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>org.atari.raster.rmt.ui.RmtApplication</mainClass>
									<manifestEntries>
										<Implementation-Version>${project.version}</Implementation-Version>
										<Build-Date>${maven.build.timestamp}</Build-Date>
									</manifestEntries>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
