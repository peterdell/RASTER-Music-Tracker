;*
;* Raster Music Tracker, RMT Atari routine version 1.20090108
;* (c) Radek Sterba (Raster/C.P.U.), 2002 - 2009
;* http://raster.atari.org
;*
;* Raster's Warnings:
;*
;* 1. RMT player routine needs 19 reserved bytes in the zero page that are not accessed
;*    from any other routines) as well as cca 1KB of memory before the "PLAYER" 
;*    address for frequency tables and functionary variables. It's:
;*	  a) from PLAYER-$03c0 to PLAYER for stereo RMTplayer 
;*    b) from PLAYER-$0320 to PLAYER for mono RMTplayer
;*
;* 2. RMT player routine MUST (!!!) be compiled from the begin of the memory page.
;*    i.e. "PLAYER" address can be $..00 only!
;*
;* 3. Because of RMTplayer provides a lot of effects, it can spend a lot of CPU time.
;*

; Raster's change history:
; 10.12.2002
; - speed-change fix - A changed speed is written to v_speed only after all 4 (resp. 8)
;   tracks are done. i.e. if the change is in the first row of a track and a goto moves it
;   to the first row, but the second track has an end (=> all actions in this row are
;   invalid and the next song line is taken), then even the speed change from the first row
;   of the first track does not take effect

; 14.12.2002
; - more tracks - Instead of the original tracks 0-$7f extended to 0-$fd ($fe is jump, $ff
;   empty track) the module header gained 2 bytes - it now holds a pointer to the array of
;   low bytes of the track pointers and (in addition) a pointer to the array of high bytes
;   of the track pointers

; 14.12.2002
; - filter and 16-bit bass rework - If a track's resulting volume is 0 (no noise component),
;   neither filtering nor 16-bit bass is applied for that generator => the other generator
;   is not blocked (for the filter or for the low byte of the 16-bit bass) and it can play
;   its own content normally, as its track says (note: this cost 56 bytes of code (stereo
;   56=8x7 bytes, mono 28=4x7 bytes))

; 14.12.2002
; - basstab1 shift - shifted by 8 tones and the lowest 8 filled in with ones an octave
;   higher this tunes bass 1 to everything else (note: bass 2 is correct as it is)

; 21.12.2002
; - command 2 fixed - frequency shift (the bug: it had no effect combined with table shifts)

; 21.12.2002
; - the SetPokey routine reworked separately for stereo and for mono

; 25.12.2002
; - parameter order in the header changed:
;	p_instrstable		org *+2		;203-4
;	p_trackslbstable	org *+2		;205-6
;	p_trackshbstable	org *+2		;207-8
;	p_song				org *+2		;209-210

; 28.12.2002
; - extended pause specification. If the top two bits are 00 it behaves as before and the
;   pause is given by the next byte; if those two bits are >00 they directly give a pause of
;   1, 2 or 3 rows and the next byte is not used (=> considerable size saving in the
;   resulting RMT files!!!)

; 14.01.2003
; - song line number definition fixed (it multiplied by *4 even for STEREO, now MONO is *4,
;   STEREO *8)

; 18.01.2003
; - envelope command $7 added - BaseNote = $XY

; 03.02.2003
; - formatting of the frq and volume tables reworked

; 08.02.2003
; - PLAYER ROUTINE MODIFICATION - INSTRUMENT VERSION 1 support for longer tables, longer
;   envelopes, full AUDCTL control various optimizations happened along the way => 52 bytes
;   shorter!!!

; 12.02.2003
; - RMT BUG FIX - table speed (the first table element played 1/50 shorter => shifted the
;   rest by 1/50 too) optimized while fixing => 3 bytes shorter!

; 22.02.2003
; - command $7 variation added. If the parameter is $80, the "volume only" mode is used.

; 17.04.2003
; - attempt to fix the bug of one skipped envelope processing at the start (17.04.2003) did
;   not help, so commented out again (jsr rmt_p3)

; 27.04.2003
; - another fix attempt (see 17.04.2003), again by adding that jsr rmt_p3 (uncommenting it).
;   OK! It works, but a related fix had to be made in RMTracker too

; 19.01.2004
; - added the options 4 TRACKS STEREO L1 R2 R3 L4 and 4 TRACKS STEREO L1 L2 R3 R4

; 31.01.2004
; - fixed an addition bug (carry into the high byte) when starting the song from the N-th
;   songline.
; - fixed STEREOMODE 2 and 3 so filters and 16-bit bass work correctly there too

; 11.02.2004
; - added FEAT_VOLUMEMIN and improved FEAT_AUDCTLMANUALSET (by 2 cycles) on every
;   SetUpInstrumentY2
; - added FEAT_TABLEGO

; 15.02.2004
; - various speed/size optimizations (22 bytes saved)

; 16.02.2004-21.02.2004
; - various speed/size optimizations following Jaskier's advice + some further brutally hard
;   optimizations of my own :-)
; - another 40 (!) bytes saved compared to 15.02.2004

; 13.04.2005
; - reworked the check whether the table is to be used

; 26.12.2005
; - FEAT_INSTRSPEED   (=0 => for modules with varying instr. speed 1 to 4; otherwise
;   hardcoded for one instr. speed only)
; - FEAT_CONSTANTSPEED  (if there is _NO_ speed command at all, it is nonzero and holds the
;   main, constant speed)
; - improvement via self-modifying variables ( v_instrspeed, v_maxtracklen, v_audctl,
;   v_audctl2, v_bspeed )

; 17.02.2006
; - FEAT_SFX

; 02.04.2006
; - FEAT_EFFECTVIBRATO and FEAT_EFFECTFSHIFT

; 16.04.2006
; - vibrato effect optimization

; 13.09.2007
; - fixed the FEAT optimization for Command5 combined with portamento unused anywhere
; - fixed the FEAT optimization for Command6 combined with the filter unused anywhere
; - ultra-brutal size and speed FEAT optimization of the dispatch by command number
; - improved optimization - sometimes trackn_command is not compiled/initialized at all for
;   every command!

; 30.08.2008
; - support for FEAT_GLOBALVOLUMEFADE for RMTGLOBALVOLUMEFADE

; 08.01.2009
; - label for RMTSFXVOLUME (idea by Tebe)
; - filters take priority over 16-bit bass, or over another track
;    e.g. a) if filtering crossed the lower generator of a pair joined for 16-bit bass,
;             then filtering is used and plain 8-bit bass plays instead of the 16-bit bass
;    e.g. b) if filtering is on in g0, g3 is overwritten with the filtered frequency (and g3's volume is zeroed)
; - 16-bit bass takes priority over another track (except a filtered one, see above)
;   e.g. if g1 uses 16-bit bass, it overwrites g0 with the low byte of the 16-bit frequency (and zeroes g0's volume)
; -  The portamento effect uses a transitional frequency between the source and the target tone + effvibrato/shift
;    (but not the tablenote/shift offsets, except for the setportamento 00 command,
;    where tablenote/shift is added when computing the target portamento frequency)
; - Completed
;   - Define frequencies for note 0 and the top notes 61-63 (60 is the last - for noise =0)
;   - Handle uninitialized instruments at the start of an empty track (instrument hb==0 ? skip the instrument)
;   - Initialization of all track variables to 0
;   - Have initial speed in the module header (instead of the default #8)
;   - Handle bit 7 ($80) and 0 ($01= for AUDCTL

;---------------------------------------------------------------------------------------------------------------------------------------------;

;* STEREOMODE	equ 0..3			;0 => compile RMTplayer for 4 tracks mono
;*									;1 => compile RMTplayer for 8 tracks stereo
;*									;2 => compile RMTplayer for 4 tracks stereo L1 R2 R3 L4
;*									;3 => compile RMTplayer for 4 tracks stereo L1 L2 R3 R4
;*

;* RMT FEATures definitions file
;* For optimizations of RMT player routine to concrete RMT module only!
	icl "rmt_feat.a65"

;---------------------------------------------------------------------------------------------------------------------------------------------;

;* Start of RMT definitions.
	IFT STEREOMODE==1
TRACKS		equ 8
	ELS
TRACKS		equ 4
	EIF

PLAYER			equ $3400	; Start of the standard player, also used for "tracker.obx". Beware that the memory before it is used, about $400 (1 KB).
INSTRPAR	equ 12				; Number of the instrument's "main" parameters => the table starts at byte 12, the envelope after the table end

;* RMT ZeroPage addresses
	org 203

p_tis
p_instrstable		org *+2		; ptr to instrument table ptrs
p_trackslbstable	org *+2		; ptr to low byte of track ptrs
p_trackshbstable	org *+2		; ptr to high byte of track ptrs
p_song				org *+2		; ptr to song data

ns					org *+2
nr					org *+2
nt					org *+2
reg1				org *+1
reg2				org *+1
reg3				org *+1
tmp					org *+1

	IFT FEAT_COMMAND2
frqaddcmd2			org *+1
	EIF

	IFT TRACKS>4
	org PLAYER-$400+$40				;$3040
	ELS
	org PLAYER-$400+$e0				;$30e0
	EIF

track_variables
trackn_db				org *+TRACKS	; Low byte of address for each track's data
trackn_hb				org *+TRACKS	; High byte of address to each track's data
trackn_idx				org *+TRACKS	; Track index
trackn_pause			org *+TRACKS	; Track pause (in rows). 1 = new note, 0 = nothing new
trackn_note				org *+TRACKS	; 0-59
trackn_volume			org *+TRACKS	; vvvv0000
trackn_distor 			org *+TRACKS	; dddd0000, Unpatched-only and unused in V1.28
trackn_shiftfrq			org *+TRACKS

	IFT FEAT_PORTAMENTO
trackn_portafrqc		org *+TRACKS		; Target portamento frequency
trackn_portafrqa		org *+TRACKS		; Current portamento frequency
trackn_portaspeed		org *+TRACKS		;portamento speed
trackn_portaspeeda		org *+TRACKS		;current portamento speed
trackn_portadepth		org *+TRACKS		;portamento depth
	EIF

trackn_instrx2			org *+TRACKS	; Bit pattern "xiiiiii0" for the instrument. With "x=0", a new instrument is set and initialized. With "x=0", no new instrument is set.
trackn_instrdb			org *+TRACKS
trackn_instrhb			org *+TRACKS
trackn_instridx			org *+TRACKS		;0,3,6,..,45  (3*16-3)
trackn_instrlen			org *+TRACKS		;instrument length
trackn_instrlop			org *+TRACKS		;the repeat starts there
trackn_instrreachend	org *+TRACKS		;set to $80 when the instrument end is first reached (volume decays from then on)
trackn_volumeslidedepth org *+TRACKS		;volume decay
trackn_volumeslidevalue org *+TRACKS		;current state of the volume decay

	IFT FEAT_VOLUMEMIN
trackn_volumemin		org *+TRACKS		;minimum volume value while decaying
	EIF

FEAT_EFFECTS equ FEAT_EFFECTVIBRATO||FEAT_EFFECTFSHIFT
	IFT FEAT_EFFECTS
trackn_effdelay			org *+TRACKS
	EIF

	IFT FEAT_EFFECTVIBRATO
trackn_effvibratoa		org *+TRACKS		;current vibrato index
	EIF

	IFT FEAT_EFFECTFSHIFT
trackn_effshift		org *+TRACKS
	EIF

trackn_tabletypespeed org *+TRACKS			;table type $00=notes,$80=frequencies ; 0-$3f table speed

	IFT FEAT_TABLEMODE
trackn_tablemode	org *+TRACKS			;table mode $00=set,$40=add
	EIF

trackn_tablenote	org *+TRACKS			;table note shift
trackn_tablea		org *+TRACKS			;current index
trackn_tableend		org *+TRACKS			;table length

	IFT FEAT_TABLEGO
trackn_tablelop		org *+TRACKS			;table repeat
	EIF

trackn_tablespeeda	org *+TRACKS			; The current table speed

	IFT FEAT_FILTER||FEAT_BASS16
trackn_command		org *+TRACKS			; The instrument command currently being executed
	EIF
	IFT FEAT_BASS16
trackn_outnote		org *+TRACKS			;resulting note (after all shifts)
	EIF
	IFT FEAT_FILTER
trackn_filter		org *+TRACKS			; Frequency shift of the filtering generator.
	EIF

trackn_audf	org *+TRACKS
trackn_audc	org *+TRACKS
	IFT FEAT_AUDCTLMANUALSET
trackn_audctl		org *+TRACKS
	EIF

;v_audctl		org *+1						;the lda #... parameter is overwritten directly in the code
;v_audctl2		org *+1						;the lda #... parameter is overwritten directly in the code
;
;	IFT FEAT_CONSTANTSPEED==0
;v_speed			org *+1					;the parameter of lda #$ff is overwritten directly in the code
;	EIF
v_aspeed		org *+1
;v_bspeed		org *+1						;buffer speed (until the changed speed is known to apply)
;											;the parameter of lda #$ff is overwritten directly in the code
;	IFT FEAT_INSTRSPEED==0||FEAT_INSTRSPEED>1
;v_instrspeed	org *+1						;the parameter of lda #$ff is overwritten directly in the code
;v_ainstrspeed	org *+1						;the parameter of lda #$ff is overwritten directly in the code
;	EIF
;v_maxtracklen	org *+1						;the parameter of cmp #$ff is overwritten directly in the code
;v_abeat			org *+1					;the parameter of lda #$ff is overwritten directly in the code
track_endvariables

;* End of RMT definitions.
	
;---------------------------------------------------------------------------------------------------------------------------------------------;

; Start of the RMT data

		org PLAYER-$100-$140-$40+2


tabbeganddistor ; The start offsets into "tabfrq" and distortion values for the individual instrument distortions
 dta frqtabpure-frqtab,$00				;noise 0
 dta frqtabpure-frqtab,$20				;noise 2
 dta frqtabpure-frqtab,$40				;noise 4
 dta frqtabbass1-frqtab,$c0				;16-bit bass (if not g1 or g3, then bass tab 1)
 dta frqtabpure-frqtab,$80				;noise 8
 dta frqtabpure-frqtab,$a0				;pure tones
 dta frqtabbass1-frqtab,$c0				;bass tab1
 dta frqtabbass2-frqtab,$c0				;bass tab2

		IFT FEAT_EFFECTVIBRATO
vibtabbeg
		dta 0,vib1-vib0,vib2-vib0,vib3-vib0
vib0	dta 0						;no vibrato
vib1	dta 1,-1,-1,1				;small vibrato
vib2	dta 1,0,-1,-1,0,1			;middle vibrato
vib3	dta 1,1,0,-1,-1,-1,-1,0,1,1	;big vibrato
vibtabnext
		dta vib0-vib0+0
		dta vib1-vib0+1,vib1-vib0+2,vib1-vib0+3,vib1-vib0+0
		dta vib2-vib0+1,vib2-vib0+2,vib2-vib0+3,vib2-vib0+4,vib2-vib0+5,vib2-vib0+0
		dta vib3-vib0+1,vib3-vib0+2,vib3-vib0+3,vib3-vib0+4,vib3-vib0+5,vib3-vib0+6,vib3-vib0+7,vib3-vib0+8,vib3-vib0+9,vib3-vib0+0
		EIF

		org PLAYER-$100-$140		;5 tables*$40 = $140
;
;		The regular notes are 0-59.
;		The notes 60,61,62,63 use note 63's frequency but VOLUME=0, sot they are inaudible.
;
;
	IFT FEAT_BASS16
frqtabbasslo
	dta $F2,$33,$96,$E2,$38,$8C,$00,$6A,$E8,$6A,$EF,$80,$08,$AE,$46,$E6
	dta $95,$41,$F6,$B0,$6E,$30,$F6,$BB,$84,$52,$22,$F4,$C8,$A0,$7A,$55
	dta $34,$14,$F5,$D8,$BD,$A4,$8D,$77,$60,$4E,$38,$27,$15,$06,$F7,$E8
	dta $DB,$CF,$C3,$B8,$AC,$A2,$9A,$90,$88,$7F,$78,$70,$6A,$64,$5E,$00
;the high bytes (basshi) come after the frqtab tables, so that frqtab sits on a page boundary
	EIF
;
		org PLAYER-$100-$100		;4 tables*$40 = $100
frqtab
	ERT [<frqtab]!=0	;* frqtab must begin at the memory page bound! (i.e. $..00 address)
;BASS 1 (0c)
;8 extra tones an octave up, to align the tuning
frqtabbass1
	dta $BF,$B6,$AA,$A1,$98,$8F,$89,$80,$F2,$E6,$DA,$CE,$BF,$B6,$AA,$A1
	dta $98,$8F,$89,$80,$7A,$71,$6B,$65,$5F,$5C,$56,$50,$4D,$47,$44,$3E
	dta $3C,$38,$35,$32,$2F,$2D,$2A,$28,$25,$23,$21,$1F,$1D,$1C,$1A,$18
	dta $17,$16,$14,$13,$12,$11,$10,$0F,$0E,$0D,$0C,$0B,$0A,$09,$08,$07
;and here the top 8 were removed
;-------------------
;BASS 2 (0e)
frqtabbass2
	dta $FF,$F1,$E4,$D8,$CA,$C0,$B5,$AB,$A2,$99,$8E,$87,$7F,$79,$73,$70
	dta $66,$61,$5A,$55,$52,$4B,$48,$43,$3F,$3C,$39,$37,$33,$30,$2D,$2A
	dta $28,$25,$24,$21,$1F,$1E,$1C,$1B,$19,$17,$16,$15,$13,$12,$11,$10
	dta $0F,$0E,$0D,$0C,$0B,$0A,$09,$08,$07,$06,$05,$04,$03,$02,$01,$00
;
;pure tones (0a) and for noise 0,2,4,8
frqtabpure
	dta $F3,$E6,$D9,$CC,$C1,$B5,$AD,$A2,$99,$90,$88,$80,$79,$72,$6C,$66
	dta $60,$5B,$55,$51,$4C,$48,$44,$40,$3C,$39,$35,$32,$2F,$2D,$2A,$28
	dta $25,$23,$21,$1F,$1D,$1C,$1A,$18,$17,$16,$14,$13,$12,$11,$10,$0F
	dta $0E,$0D,$0C,$0B,$0A,$09,$08,$07,$06,$05,$04,$03,$02,$01,$00,$00
;
	IFT FEAT_BASS16
frqtabbasshi
	dta $0D,$0D,$0C,$0B,$0B,$0A,$0A,$09,$08,$08,$07,$07,$07,$06,$06,$05
	dta $05,$05,$04,$04,$04,$04,$03,$03,$03,$03,$03,$02,$02,$02,$02,$02
	dta $02,$02,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$00,$00
	dta $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
	EIF

		org PLAYER-$0100		; 256 bytes before the player.

; Volume conversion
volumetab
	dta $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
	dta $00,$00,$00,$00,$00,$00,$00,$00,$01,$01,$01,$01,$01,$01,$01,$01
	dta $00,$00,$00,$00,$01,$01,$01,$01,$01,$01,$01,$01,$02,$02,$02,$02
	dta $00,$00,$00,$01,$01,$01,$01,$01,$02,$02,$02,$02,$02,$03,$03,$03
	dta $00,$00,$01,$01,$01,$01,$02,$02,$02,$02,$03,$03,$03,$03,$04,$04
	dta $00,$00,$01,$01,$01,$02,$02,$02,$03,$03,$03,$04,$04,$04,$05,$05
	dta $00,$00,$01,$01,$02,$02,$02,$03,$03,$04,$04,$04,$05,$05,$06,$06
	dta $00,$00,$01,$01,$02,$02,$03,$03,$04,$04,$05,$05,$06,$06,$07,$07
	dta $00,$01,$01,$02,$02,$03,$03,$04,$04,$05,$05,$06,$06,$07,$07,$08
	dta $00,$01,$01,$02,$02,$03,$04,$04,$05,$05,$06,$07,$07,$08,$08,$09
	dta $00,$01,$01,$02,$03,$03,$04,$05,$05,$06,$07,$07,$08,$09,$09,$0A
	dta $00,$01,$01,$02,$03,$04,$04,$05,$06,$07,$07,$08,$09,$0A,$0A,$0B
	dta $00,$01,$02,$02,$03,$04,$05,$06,$06,$07,$08,$09,$0A,$0A,$0B,$0C
	dta $00,$01,$02,$03,$03,$04,$05,$06,$07,$08,$09,$0A,$0A,$0B,$0C,$0D
	dta $00,$01,$02,$03,$04,$05,$06,$07,$07,$08,$09,$0A,$0B,$0C,$0D,$0E
	dta $00,$01,$02,$03,$04,$05,$06,$07,$08,$09,$0A,$0B,$0C,$0D,$0E,$0F

; End of the RMT data.
 
;---------------------------------------------------------------------------------------------------------------------------------------------;

	org PLAYER

;
; Start of the RMT jump table.
;
RASTERMUSICTRACKER
	; Initialize
	;
	; Must be run first, to clear memory and initialize the player.
	; Once this is done, run rmt_play afterwards, or Set_Pokey if you want to manually time certain things.
	; IN:  <X>=module address low byte, Y=module address high byte, <A>=starting song line(0-255)
	; OUT: <A>=the instrument speed (1= 1 time per VBI (normal), 2 = 2 times per VBI, 3 = 3 times per VBI, ...
	jmp rmt_init			;* 

	; Play
	;
	; "SetPokey" is called first, then all the play code is ran once. 
	; V: Must be called multiple times per frame if the instrument speed is > 1.
	; R: every 1/50 sec, returns the actual instrument speed
	; IN:  n/a
	; OUT: <A>=the current the instrument speed. TODO: JAC! Really? This was in Raster's comment.
	; TODO: JAC! How does this relate to rmt_p3? Rasters original comment clearly states that "rmt_play" is per frame.
	; So it would make sense that rmt_p3 is to be called within a frame to update only the instruments.
	jmp rmt_play

	; Play3
	; R: ;(without SetPokey, Song and Track handling) from the instrument processing on
	; Similar to rmt_play, but will also skip SetPokey and the instruments/songlines/tracklines initialization.
	jmp rmt_p3

	; Set Silence
	;
	; Sets all Pokey registers to their initial values.
	; This is also last part of "rmt_init".
	; IN:  n/a
	; OUT: n/a
	jmp rmt_silence

	; Set Pokey Registers
	;
	; Copies the contents of the shadow Pokey registers (v_audctl, v_skctl, trackn_audf,x etc) into the hardware registers.
	; This is call as the first step in "rmt_play".
	; IN:  n/a
	; OUT: n/a
	jmp SetPokey

	IFT FEAT_SFX
	; Play Sound Effect
	;
	; Plays a note with a given instrument on a given channel.
	; This overrides the instrument played by the song.
	; IN: <A>=note(0,..,60), <X>=channel(0,..,3 in mono or 0,..,7 in stereo), <Y>=instrument*2 (0,2,4,..,126) 
	jmp rmt_sfx	
	EIF
	
; End of the RMT jump table.

;---------------------------------------------------------------------------------------------------------------------------------------------;

; Start of rmt_init code.
; A = Starting song line
; X = low byte of the RMT module
; Y = High byte of the RMT module

rmt_init
	stx ns
	sty ns+1
	IFT FEAT_NOSTARTINGSONGLINE==0
		pha	; Push the start song line to the stack for now (PHA #1).
	EIF
	
;	Clear the track_variables
	IFT [track_endvariables-track_variables]>255
;		There are more than 255 trackn variables, but less than 513.
;		So clear from the front and 256 bytes from the end |>--->----|
	ldy #0
	tya
ri0	sta track_variables,y
	sta track_endvariables-$100,y
	iny
	bne ri0
	ELS
		; Clear from the back  |----<|
		ldy #track_endvariables-track_variables	; Number of bytes to clear
	lda #0
ri0		sta track_variables-1,y		; Shifted down by 1, so n down to 1 suffices and bne can be used
	dey
	bne ri0	
	EIF	

	; Parse the RMT module data
	; The track length is at offset +4
	ldy #4
	lda (ns),y
	sta v_maxtracklen	; Set the maximum track length.

	; The song speed is at offset +5
	iny	
	IFT FEAT_CONSTANTSPEED==0
		lda (ns),y
		sta v_speed			; Set the default track speed
	EIF
	
	; The instrument speed is at offset +6
	IFT FEAT_INSTRSPEED==0
		iny	;#6
		lda (ns),y
		sta v_instrspeed		;Set the instrument speed
		sta v_ainstrspeed
	ELI FEAT_INSTRSPEED>1
		lda #FEAT_INSTRSPEED
		sta v_ainstrspeed
	EIF

	; The offset +7 is reserved.

	; Copy 4 pointers starting at offset 8, i.e. offsets 8,9; 10,11; 12,13; 14,15.
	; -> InstrumentPtrs[] 	2 bytes
	; -> TracksPtrsLow[]	2 bytes
	; -> TracksPtrsHi		2 bytes
	; -> SongData			2 bytes

	ldy #8							; Starting from offset 8
ri1	lda (ns),y
	sta p_tis-8,y
	iny
	cpy #8+8						; copy 2*4 = 8 bytes
	bne ri1

	IFT FEAT_NOSTARTINGSONGLINE==0
		; Set the starting song line by moving p_song forward
		pla							; Pull the saved start song line from the stack (PLA #1).
		pha							; Push the start song line on the stack (PHA #2A/B).
		IFT TRACKS>4
			; Stereo
			; p_song += song_line * 8
			asl @					;stereo 8 tracks => every song line has 8 bytes
			asl @
			asl @					;=*8
			clc
			adc p_song				; p_song += offset * 8 (low) part
			sta p_song
			pla						; Pull the saved start song line from the stack (PLA #2A). This keeps carry flag unchanged.
			php						; Push the flags, we will need the carry flag later (#PHP 3A).
			and #$e0				;top 3 bits
			asl @					;into carry
			rol @					;bit 1
			rol @					;bit 2
			rol @					;bit 3
		ELS
			; Mono
			; p_song += song_line * 4
			asl @					;mono 4 tracks => every song line has 4 bytes
			asl @					;=*4
			clc
			adc p_song
			sta p_song
			pla						;PLA 2B!!!
			php						;PHP 3B!!! (saves the carry)
			and #$c0				;top 2 bits
			asl @					;into carry
			rol @					;bit 1
			rol @					;bit 2
		EIF
		plp							; Pull the saved flags, we need the carry flag (PLP #3A/B).
		adc p_song+1				;The carry flag was set by the low-byte addition.
		sta p_song+1
	EIF 							; End of IFT FEAT_NOSTARTINGSONGLINE==0

;	jsr GetSongLine
;	jsr GetTrackLine
;	jsr InitOfNewSetInstrumentsOnly	;first-time instrument setup
;	jsr rmt_p3						;fix 27.04.2003 (first call of the p3 part was skipped => 1/50 shift at the start)

	jsr GetSongLine					; Setup the first song line, track line, init new instruments and call rmt_play3.

;	jsr rmt_silence				; OPTIMIZATION: continues directly into rmt_silence
;	lda v_instrspeed			; OPTIMIZATION: <--this load of the value is at the end of rmt_silence
;	rts							; OPTIMIZATION: before the rts instruction.

; End of the rmt_init code.
; Note: rmt_silence will always be executed next via fall-through.

;---------------------------------------------------------------------------------------------------------------------------------------------;
	
; RMT_SILENCE
; Reset POKEY causes all sound to be stopped

rmt_silence
	; Reset POKEY
	IFT STEREOMODE>0			;for 1, 2 and 3 alike
		lda #0
		sta $d208			; AUDCTL
		sta $d218
		ldy #3
		sty $d20f			; SKCTL
		sty $d21f

		ldy #8				; Clear AUDFx & AUDCx
si1		sta $d200,y
		sta $d210,y
		dey
		bpl si1
	ELS
		lda #0
		sta $d208
		ldy #3
		sty $d20f
		ldy #8
si1		sta $d200,y
		dey
		bpl si1
	EIF
	IFT FEAT_INSTRSPEED==0			;Return the instrument speed for the fall-through from "rmt_init". Not relevant/guaranteed for "rmt_silence" itself.
	lda v_instrspeed
	ELS
	lda #FEAT_INSTRSPEED
	EIF
	rts

; End of rmt_silence code.
	
;---------------------------------------------------------------------------------------------------------------------------------------------;

GetSongLine		; Get songline, then get track line, then initialize new instruments
	ldx #0							; Set the current beat in to 0.
	stx v_abeat	
nn0								; Before jumping to nn0 from elsewhere, ensure that <X>=0.
;   Next line in the song
;	ldx #0						;must start at column 0 and continue 0->7, because a goto can be there
;   on the first pass (via GetSongLine...) x=0, jumping to nn0 from elsewhere requires ldx #0 before the jump

nn1
	txa							; Y:=A:=X 0,1,2,3
	tay
	lda (p_song),y					; Get track info from the songline[y]
	cmp #$fe						; #$FE = Goto songline, #$FF = Empty track
	bcs nn2							; if A >= $FE, branch to nn2
	; <A> = Real track number $00-$fd.

	; Get the ptr to the track data and store it in p_trackslbstable
	tay
	lda (p_trackslbstable),y		; trackn_db[x] = p_trackslbstable[y]
	sta trackn_db,x
	lda (p_trackshbstable),y		; trackn_hb[x] = p_trackshbstable[y]
	sta trackn_hb,x

	lda #0
	sta trackn_idx,x				; Reset the track index to 0.

	lda #1						
nn1a2 								; Init track,  #1 is a new track, #0 is no new track
	sta trackn_pause,x				; OPTIMIZATION: So it can jump to nn1a2 for an empty track (i.e. must include the $80 -> instrx2,x below)
	lda #$80						; Initialize as "no new instrument" ($80).
	sta trackn_instrx2,x			; Note values "0-60" do not change it, $80 stays there.
	inx
	cpx #TRACKS	
	bne nn1

	; Done with data points of a song line, move to the next line
	lda p_song						; p_song += #TRACKS
	clc
	adc #TRACKS
	sta p_song
	bcc GetTrackLine				;Instead of "bcc nn1b", jump straight to GetTrackLine.
	inc p_song+1
;nn1b
;	rts								; The end of GetSongLine.
	jmp GetTrackLine				; The end of GetSongLine. Continues to GetTrackLine to progress the next notes in the track.

nn2									; Track number >= GOTO ($fe) or EMPTY TRACK ($ff)
;	cmp #$fe						; Was already done before jumping here
	beq nn3							; Yes, it is GOTO (#$fe) => branch

nn2a								; Track number is EMPTY TRACK ($ff).
	lda #0							; 0 is the maximum pause length (256).
	beq nn1a2						; Unconditional jump to nn1a2.

nn3									; Track number is GOTO ($fe).
									; Data format: $fe, unused ($00), low/high byte of pointer to the next song line.
	ldy #2
	lda (p_song),y					; lo = p_song[2]
	tax
	iny
	lda (p_song),y					; hi = ptrSongLinex[3]
	sta p_song+1
	stx p_song						; (p_song) = p_song[2,3]
	ldx #0							; <X> must be 0 before jumping to nn0, to process the new song line from #0 (up to 7)
	beq nn0							; Unconditional jump to the next song line.

; Process the next line of a track for all tracks.
GetTrackLine		;does get trackline (calling GetSongline back if needed), then instrument init

	IFT FEAT_CONSTANTSPEED==0
		lda #$ff					; The speed as immediate operand is is changed by the code.
v_speed equ *-1
		sta v_bspeed				; Store a copy as the buffer speed.
	EIF

	ldx #-1							; Must run from 0 to TRACKS (not the other way), because speeds on the same trackline overwrite each other.
									; And because ENDofTRACK can stop it in any column, so the opposite side would get executed.
oo1
	inx								; <X>=0 to TRACKS-1
;	lda trackn_pause,x				; OPTIMIZATION: If it was 0, is would be an infinite pause. With these lines commented out it will count down from 255 to 1.
;	beq oo1x						; OPTIMIZATION: This works out the same as an infinite pause, because the longest track can have 256 rows
	dec trackn_pause,x
	bne oo1x						; >0 => pause is 1-255.

;OPTIMIZATION:	inc trackn_pause,x	;trackn_pause=1
;OPTIMIZATION: 1 cycle faster than via lda #1 sta...
;OPTIMIZATION: and moved to run only for a note or a volume change (when volume is set)
;	lda #1
;	sta trackn_pause,x	

	; Setup the pointer to the track data.
oo1b
	lda trackn_db,x					; (ns) = trackn_db/hi[x]
	sta ns
	lda trackn_hb,x
	sta ns+1
oo1i
	ldy trackn_idx,x				; <Y> = current index into track data (34 ... 12).
	inc trackn_idx,x				; Increment the track index for next call.

	; Get a track data point
	; 0 - 60 = Note, instr and volume data
	; 61 - Volume only
	; 62 = Pause/empty line
	; 63 - Speed, go loop or end
	lda (ns),y						; vvnnnnnn iiiiiivv		(v=volume,n=note,i=instrument)
	sta reg1
	and #$3f						; 0-63
	cmp #61							; 61-63 are special notes, i.e. commands.
	beq oo1a						; =61, this is the empty note. It only sets the volumne bit not the note and instrument.
	bcs oo2							; >61

	; Not a command so store the note (0-60).
	sta trackn_note,x				; Set the track note.
	IFT FEAT_BASS16	
	sta trackn_outnote,x			;(if nothing changes it anymore, it stays the same as note)
	EIF

	; Get the instrument number, multiplied by 2.
	iny
	lda (ns),y						; instrx2 = (data & 0xfc) >> 1
	lsr @							; 0iiiiiiX
	and #$3f*2						; 0iiiiii0
	sta trackn_instrx2,x			; Set the track instrument.

oo1a								; Process volume data
	lda #1							; After a note (or a volume change) there is a pause of 1 row
	sta trackn_pause,x				; Got a note.

	; Get the volume
	ldy trackn_idx,x				; <Y> := track index
	inc trackn_idx,x				; Move to the next data point in the track
	lda (ns),y
	lsr @
	ror reg1
	lsr @
	ror reg1
	lda reg1
	IFT FEAT_GLOBALVOLUMEFADE
	sec
	sbc #$00				; self-modified parameter
RMTGLOBALVOLUMEFADE equ *-1
	bcs voig	;>=0
	lda #0		;<0 => must zero it
voig
	EIF
	and #$f0				; vvvv0000
	sta trackn_volume,x		; Sets the volume.
oo1x
	cpx #TRACKS-1
	bne oo1 				;X stays at #TRACKS-1, which is used below

	IFT FEAT_CONSTANTSPEED==0
	lda #$ff			;speed from the buffer (the parameter is self-modified)
v_bspeed equ *-1	;the parameter is self-modified
	sta v_speed				;only now (after all tracks are processed) is it written to the overall speed
	ELS
	lda #FEAT_CONSTANTSPEED
	EIF
	sta v_aspeed			;and to the current one too

	;END of GetTrackLine => falls through to the instrument initialization with X = #TRACKS - 1 !
	jmp InitOfNewSetInstrumentsOnly		;X must be equal to #TRACKS-1

oo2										; Note/command is 62 or 63.
	cmp #63
	beq oo63				;=63 => branch

	lda reg1				;note=62 (00pause, byte ; or 01pause =1 row, 10pause =2 rows, 11pause =3 rows )
	and #$c0				;top two bits
	beq oo62_b				;zero => the next byte is the pause size => branch

	asl @					;xy000000 => C y0000000
	rol @					;C y0000000 => C 0000000x
	rol @					;C 0000000x => 000000xy
	sta trackn_pause,x
	jmp oo1x

oo62_b
	iny
	lda (ns),y
	sta trackn_pause,x
	inc trackn_idx,x		;for next time
	jmp oo1x
oo63
	lda reg1
	IFT FEAT_CONSTANTSPEED==0
	bmi oo63_1X
;oo63_0X
;note=63 (+top bit 0) (speed, byte)
	iny
	lda (ns),y
		sta v_bspeed				; Set the song speed to the buffered speed.
	inc trackn_idx,x			;for next time
	jmp oo1i					;immediately continues to the next pair in the track
oo63_1X
	EIF
	cmp #255		;192+63(go) => 255 (=END, ends all tracks and advances in the song)
	beq oo63_11

;note=63 (top two bits 10)
	iny
	lda (ns),y
	sta trackn_idx,x
	jmp oo1i		;immediately continues to the next pair in the track
oo63_11
;note=63 (top two bits 11) (=>byte1=255)
	jmp GetSongLine

p2xrmtp3			; The bmi p2xrmt_p3 a bit below makes use of this
	jmp rmt_p3

p2x0				; Jumped-to only on the next pass of the <X> loop from 7->0
	dex	
	bmi p2xrmtp3	; Loop ended, X=-11

;	END of the InitOfNewSetInstrumentsOnly part => falls through to rmt_p3

InitOfNewSetInstrumentsOnly		; CAUTION! Before jumping to InitOfNewSetInstrumentsOnly, ldx #TRACKS-1 must be loaded
p2x1
	ldy trackn_instrx2,x		; Get the instrument number*2 in the current track.
	bmi p2x0					; If bit 7 is set, there is no new instrument to initialize. Process withthe next track.
	
;---------------------------------------------------------------------------------------------------------------------------------------------;

; Start of the RMT_SFX code.
	
	IFT FEAT_SFX
		jsr SetUpInstrumentY2
		jmp p2x0
	
rmt_sfx
		sta trackn_note,x		; Set trackn_note.
		IFT FEAT_BASS16	
		sta trackn_outnote,x	; If nothing changes it anymore, it stays the same as note.
		EIF
		lda #$f0				;* sfx note volume*16
	RMTSFXVOLUME equ *-1		;* label for sfx note volume parameter overwriting
		sta trackn_volume,x		; Sets the volume
		EIF						; Fall-though to SetUpInstrumentY2 with <Y> = instrument number *2, <X> = track number
	
; End of RMT_SFX code.

;---------------------------------------------------------------------------------------------------------------------------------------------;
	
;it is inlined right here
SetUpInstrumentY2				; IN: <Y> holds the instrument number *2, <X> the track number
	lda (p_instrstable),y
	sta trackn_instrdb,x		; Set the instrument table pointer.
	sta nt
	iny
	lda (p_instrstable),y
	sta trackn_instrhb,x
	sta nt+1

	IFT FEAT_FILTER	
		lda #1					; This is the RMT 1.28 value.
		sta trackn_filter,x		; Set the filtering offset value on new notes.
	EIF

	IFT FEAT_TABLEGO			;TABLEGO
	IFT FEAT_FILTER
	tay		;y=1				;with FEAT_FILTER, reuses A=1 via TAY (=> Y=1)
	ELS
	ldy #1	;y=1				;without FEAT_FILTER, must do ldy #1
	EIF
	lda (nt),y
	sta trackn_tablelop,x
	iny ;#2
	ELS					;/TABLEGO else
	ldy #2
	EIF					;/TABLEGO
;y=2
	lda (nt),y
	sta trackn_instrlen,x
;y=2 still
	iny ;#3
	lda (nt),y
	sta trackn_instrlop,x
;y=3
	iny ;#4
	lda (nt),y
	sta trackn_tabletypespeed,x			;tmss ssss (type mode speed)
	IFT FEAT_TABLETYPE||FEAT_TABLEMODE
	and #$3f							;00ss ssss -tablespeed $00-$3f
	EIF
	sta trackn_tablespeeda,x
	IFT FEAT_TABLEMODE	
	lda (nt),y
	and #$40							;0m00 0000 (mode only)
	sta trackn_tablemode,x
	EIF
;y=4
	IFT FEAT_AUDCTLMANUALSET
	iny	;#5	
	lda (nt),y
	sta trackn_audctl,x						;audctl
	iny ;#6
	ELS
	ldy #6
	EIF
;y=6
	lda (nt),y
	sta trackn_volumeslidedepth,x			;volume decay on every "goto" in the instrument
;y=6 still
	IFT FEAT_VOLUMEMIN
	iny ;#7
	lda (nt),y								;mmmm 0000 volume minimum for the volume decay
;	and #$f0								; Not required bits are already 0.
	sta trackn_volumemin,x
	IFT FEAT_EFFECTS
	iny	;#8
	EIF ;/FEAT_EFFECTS
	ELS ;else FEAT_VOLUMEMIN
	IFT FEAT_EFFECTS
	ldy #8
	EIF ;/FEAT_EFFECTS
	EIF
;y=8 (careful, Y=8 only with FEAT_EFFECTS !!! (otherwise not needed)
	IFT FEAT_EFFECTS
	lda (nt),y								;effdelay
	sta trackn_effdelay,x
	IFT FEAT_EFFECTVIBRATO
	iny ;#9
	lda (nt),y								;effvibrato  0000 00vv  ($0-$3)
;	and #$03								; Not required bits are already 0.
	tay
	lda vibtabbeg,y
	sta trackn_effvibratoa,x
	EIF
	IFT FEAT_EFFECTFSHIFT
	ldy #10									;byte 10
	lda (nt),y								;effshift
	sta trackn_effshift,x
	EIF ;/FEAT_EFFECTFSHIFT
	EIF	;/FEAT_EFFECTS

;	Note: byte 11 is free, reserved for future extensions
;	By now Y holds who-knows-what ;-)

	lda #128						;the volume decay is "rounded" (i.e. it starts from +128/256)
	sta trackn_volumeslidevalue,x
;	lda #$80						;OPTIMIZATION: moved here from below, because A=128 = $80 right now!
	sta trackn_instrx2,x			;OPTIMIZATION: the instrument was just set up, so $80 is raised again to avoid repeated setup
;	lda #0							;OPTIMIZATION
	asl @							;OPTIMIZATION: <A>=$00 (it was $80 before, asl turns that into $00)
	sta trackn_instrreachend,x		;then on the first instrument "go" it is set to $80 (volume starts decaying from then on)
	sta trackn_shiftfrq,x
;	carry is now always C=1 (after asl of the value 128)

	tay								; <Y>:=<A>=$00, carry stays C=1
;y=0
	lda (nt),y			    		; Carry stays C=1.
	sta trackn_tableend,x   		; Carry stays C=1.
;	clc								; Carry stays C=1. Saves 2 cycles compared to "clc:adc #1"
	adc #0							; <A>:=<A>+1 because C=1.
	sta trackn_instridx,x			; The envelope starts 1 byte after the table
;
;and now the remaining parameters
	lda #INSTRPAR							;12
	sta trackn_tablea,x						;starts from table entry 0 (=byte 12)
	tay	;ldy #INSTRPAR	
	lda (nt),y								;note 0 of the instrument table	(=byte 12)
	sta trackn_tablenote,x					;if tableend=0 => only this ever remains

xata_rtshere				;rmt_ata.a65 writes an "rts" instruction onto this label so that
							;the JSR SetUpInstrumentY2 routine can be called as a subroutine.
	IFT FEAT_SFX
		rts
	ELS
		jmp p2x0		; Process the next channel's instrument.
	EIF

;---------------------------------------------------------------------------------------------------------------------------------------------;
;
; Start of "RMT_PLAY" code.
;
;---------------------------------------------------------------------------------------------------------------------------------------------;

;called every 1/50 sec.
rmt_play
;
rmt_p0
;------------------------------------------------------------------------------------------
;setting the POKEY registers

	jsr SetPokey

rmt_p1
;------------------------------------------------------------------------------------------
;	Are the instruments running faster than VBI?

	IFT FEAT_INSTRSPEED==0||FEAT_INSTRSPEED>1
	dec v_ainstrspeed
	bne rmt_p3						;continue to the instrument envelope processing
									;(skipping the classic track processing)
	EIF
	IFT FEAT_INSTRSPEED==0
	lda #$ff						;the parameter is self-modified
v_instrspeed	equ *-1
	sta v_ainstrspeed
	ELI FEAT_INSTRSPEED>1
	lda #FEAT_INSTRSPEED
	sta v_ainstrspeed
	EIF


;------------------------------------------------------------------------------------------
rmt_p2								; Track processing
	dec v_aspeed
	bne rmt_p3			;jump (past the initialization of newly set instruments)
;
	inc v_abeat			;current beat++
	lda #$ff			;the parameter is self-modified   v_abeat
v_abeat equ *-1
	cmp #$ff			;is it the maximum track length?
v_maxtracklen equ *-1	;parameter self-modification
	beq p2o3			;yes => branch
;no, so continue to the next track line
;p2o2
	jmp GetTrackLine	;(which itself calls GetSongLine when needed)
						;and then also calls InitOfNewSetInstrumentsOnly and continues to rmt_p3
p2o3
;yes => next song line
;;	jsr GetSongLine		;next line in the song (v_abeat is initialized there)
;	jsr GetSongLineTrackLineInitOfNewSetInstrumentsOnly
;	jmp rmt_p3
	jmp GetSongLine				; Get song line, track line, init new instruments and continue to rmt_p3.
;
;
;
;
go_ppnext	jmp ppnext	;just a FAR jump for the beq a bit below whose branch is out of range
;
rmt_p3
;------------------------------------------------------------------------------------------
;envelope processing
	lda #>frqtab
	sta nr+1
;	ldx #0						;OPTIMIZATION from 0->7 (x++)
xtracks05sub1	ldx #TRACKS-1	;OPTIMIZATION to 7->0 (x--)  ...for the envelope processing the order may be swapped
;	stx nr			(the low byte is set during the envelope processing)
pp1
	lda trackn_instrhb,x
	beq go_ppnext						;a bit above is go_ppnext jmp ppnext
	sta ns+1
	lda trackn_instrdb,x
	sta ns
	ldy trackn_instridx,x
	lda (ns),y
	sta reg1
	iny
	lda (ns),y
	sta reg2
	iny
	lda (ns),y
	sta reg3
	iny
	tya
	cmp trackn_instrlen,x
	bcc pp2
	beq pp2
	;an instrument goto is executed => sets trackn_instrreachend
	lda #$80
	sta trackn_instrreachend,x	
pp1b
	lda trackn_instrlop,x	
pp2	sta trackn_instridx,x
	lda reg1				;the instrument's volume envelope [rrrr llll] (R right, L left)
	IFT TRACKS>4
	cpx #4					;is it channel 4-7?
	bcc pp2s				;no, it is 0-3 => branch and use 0000 llll directly
	lsr @					;yes => shift rrrrllll
	lsr @
	lsr @
	lsr @					;=>0000rrrr
pp2s
	EIF	
	and #$0f				;0000llll (low 4 bits)
	ora trackn_volume,x		;vvvv0000
	tay
	lda volumetab,y
	sta tmp				; Backup the final volume (0-15) in "tmp". This is faster than PHA/PLA.
						; It will be used to comnpute the AUDC value a bit later.
	lda reg2
	and #$0e			;distortion 0000 ddd0
	tay					;even values
	lda tabbeganddistor,y		;offset into the tabfrq table 0,64,128,192
	sta nr				;low byte for setting the frequency from the table
	lda tmp				;takes from tmp (final volume 0-15) (faster than PHA and then PLA)
	ora tabbeganddistor+1,y		;noise value for the respective instrument distortion $00,$20,$..
	sta trackn_audc,x
;
;	jmp InstrumentsEffects
;returnfromInstrumentsEffects
;<InstrumentsEffects>
InstrumentsEffects				;X holds the track number 7-0
	IFT FEAT_EFFECTS
	lda trackn_effdelay,x
	beq ei2						;=0 => no effects
	cmp #1						;the delay decreases down to one at most
	bne ei1						;the delay decreases down to one at most
	lda trackn_shiftfrq,x
	IFT FEAT_EFFECTFSHIFT
	clc
	adc trackn_effshift,x
	EIF
	IFT FEAT_EFFECTVIBRATO
	clc
	ldy trackn_effvibratoa,x	;active vibrato index
	adc vib0,y
	EIF
	sta trackn_shiftfrq,x
	IFT FEAT_EFFECTVIBRATO
	lda vibtabnext,y			;vibrato step
	sta trackn_effvibratoa,x
	EIF
	jmp ei2
ei1
	dec trackn_effdelay,x		;the delay is greater than 1, so decrease it
ei2
	EIF ;/FEAT_EFFECTS
;table
	ldy trackn_tableend,x
	cpy #INSTRPAR+1				;<13?
	bcc ei3						;yes => the table length is <= 0 => skip it all
	;speed
	lda trackn_tablespeeda,x
	bpl ei2f					;>=0  => no movement in the table
ei2c
	;advance the table's current index
	tya
	cmp trackn_tablea,x
	bne ei2c2					;not at the end yet
	IFT FEAT_TABLEGO
	lda trackn_tablelop,x		;table lop
	ELS
	lda #INSTRPAR				;all loops always jump to 0 => fixed start of all loops (byte 12)
	EIF
	sta trackn_tablea,x
	bne ei2a					;! always branches
ei2c2
	inc trackn_tablea,x			;advance to the next
ei2a

	lda trackn_instrdb,x
	sta nt
	lda trackn_instrhb,x
	sta nt+1
	ldy trackn_tablea,x		;0-7
	lda (nt),y
	IFT FEAT_TABLEMODE	
	ldy trackn_tablemode,x	;table mode? ($00/$40)
	beq ei2e				;==$00 => sets tablenote/tableshift
	clc						;==$40 => adds to tablenote/tableshift
	adc trackn_tablenote,x
ei2e
	EIF
	sta trackn_tablenote,x
	lda trackn_tabletypespeed,x	;tmss ssss
	IFT FEAT_TABLETYPE||FEAT_TABLEMODE	
	and #$3f					;00ss ssss - speed only
	EIF
ei2f
	sec
	sbc #1
	sta trackn_tablespeeda,x

ei3
	lda trackn_instrreachend,x			;has the instrument end ever been reached?
	bpl ei4								;bit $80 == 0 => not yet => branch
	;yes => volumeslide is subtracted
	lda trackn_volume,x					;top 4 bits
	beq ei4								;volume already zero => branch
	IFT FEAT_VOLUMEMIN
	cmp trackn_volumemin,x				;at the minimum?
	beq ei4								;yes => branch (no more decay)
	bcc ei4								;even smaller => branch (no more decay)
	EIF
	tay									;stashes the volume into Y
	lda trackn_volumeslidevalue,x
	clc
	adc trackn_volumeslidedepth,x
	sta trackn_volumeslidevalue,x
	bcc ei4								;carry==0 => branch
	tya									;(carry=1)
	sbc #16								;trackn_volume uses the top 4 bits (multiples of 16)
	sta trackn_volume,x

ei4
;</InstrumentsEffects>
	IFT FEAT_COMMAND2
	lda #0
	sta frqaddcmd2				;Initialization of the frequency shift by command 2
	EIF
;	<1>
	IFT FEAT_COMMAND1||FEAT_COMMAND2||FEAT_COMMAND3||FEAT_COMMAND4||FEAT_COMMAND5||FEAT_COMMAND6||FEAT_COMMAND7SETNOTE||FEAT_COMMAND7VOLUMEONLY
;	are there any commands other than COMMAND 0 at all?
;	yes, there are!
	lda reg2
	IFT FEAT_FILTER||FEAT_BASS16
	sta trackn_command,x		; Used only for filtering and/or 16-bit bass
	EIF
		and #$70					; Mask out non-relevent bits for command "0ccc 0000".
;	<2>
	IFT 1==[FEAT_COMMAND1+FEAT_COMMAND2+FEAT_COMMAND3+FEAT_COMMAND4+FEAT_COMMAND5+FEAT_COMMAND6+[FEAT_COMMAND7SETNOTE||FEAT_COMMAND7VOLUMEONLY]]
	; There is exactly one command other than command 0
	beq cmd0		;if it is zero after and #$70, cmd0 is handled (which sits after all the commands)
					;and after this, only that single command present gets compiled (the only one other than command 0)
	ELS ;there are two or more commands besides command 0 (i.e. 3 or more in total)
	lsr @
	lsr @				;/4 (=>0,4,8,...)
	sta jmx+1
jmx	bcc *
	jmp cmd0
	nop
	jmp cmd1
	IFT FEAT_COMMAND2||FEAT_COMMAND3||FEAT_COMMAND4||FEAT_COMMAND5||FEAT_COMMAND6||FEAT_COMMAND7SETNOTE||FEAT_COMMAND7VOLUMEONLY
		nop
		jmp cmd2
	EIF
	IFT FEAT_COMMAND3||FEAT_COMMAND4||FEAT_COMMAND5||FEAT_COMMAND6||FEAT_COMMAND7SETNOTE||FEAT_COMMAND7VOLUMEONLY
		nop
		jmp cmd3
	EIF
	IFT FEAT_COMMAND4||FEAT_COMMAND5||FEAT_COMMAND6||FEAT_COMMAND7SETNOTE||FEAT_COMMAND7VOLUMEONLY
		nop
		jmp cmd4
	EIF
	IFT FEAT_COMMAND5||FEAT_COMMAND6||FEAT_COMMAND7SETNOTE||FEAT_COMMAND7VOLUMEONLY
		nop
		jmp cmd5
	EIF
	IFT FEAT_COMMAND6||FEAT_COMMAND7SETNOTE||FEAT_COMMAND7VOLUMEONLY
		nop
		jmp cmd6
	EIF
	IFT FEAT_COMMAND7SETNOTE||FEAT_COMMAND7VOLUMEONLY
		nop
		jmp cmd7
	EIF
	EIF ;</2>
	ELS ;<1ELSE> no, there are no commands other than COMMAND 0 at all, so nothing is compiled until cmd0
	;still has to add filling trackn_command,x, if needed
	IFT FEAT_FILTER||FEAT_BASS16
	lda reg2
	sta trackn_command,x		;used only for filtering and/or 16-bit bass
	EIF
	EIF ;</1>
	
; End of instruments effects code.
	
;---------------------------------------------------------------------------------------------------------------------------------------------;

; Start of the instruments commands code.
; Note: The instrument effects code falls through to this.
	
;cmd0 comes last of the commands as an optimization, so it can continue straight to pp9
;~~~~~~~~
cmd1	;play FRQ n
	IFT FEAT_COMMAND1
	lda reg3
;	sta trackn_audf,x			;OPTIMIZATION
;	jmp pp9						;OPTIMIZATION
	jmp cmd0c					;OPTIMIZATION: after cmd0c it does sta trackn_audf,x and continues straight on without the jump to pp9
	EIF


cmd2	;play NOTE + FRQ_n		[+shiftfrq]
	IFT FEAT_COMMAND2
	lda reg3
	sta frqaddcmd2				;frequency shift by command 2
	lda trackn_note,x
	jmp cmd0a
	EIF

cmd3	;NOTE = NOTE + NOTE_n	;play CMD 0 00
	IFT FEAT_COMMAND3
	lda trackn_note,x
	clc
	adc reg3
	sta trackn_note,x
	jmp cmd0a
	EIF

cmd4	;shiftfrq = shiftfrq + FRQ_n	;play CMD 0 00
	IFT FEAT_COMMAND4
	lda trackn_shiftfrq,x
	clc
	adc reg3
	sta trackn_shiftfrq,x
	lda trackn_note,x
	jmp cmd0a
	EIF

cmd5	;set destination portamento XY (X-speed, Y-depth), XY==00 =>set actual_portamento_frq=destination_portamento_frq
	IFT FEAT_COMMAND5&&FEAT_PORTAMENTO
		IFT FEAT_TABLETYPE	
			lda trackn_tabletypespeed,x		; What table type is it? 
			bpl cmd5a1						; bit 7 is 0: note shift mode (notes table mode)
			ldy trackn_note,x				; bit 8 is 1: frequency shift mode.

			lda (nr),y						; This is the actual note base frequency, or AUDF.
			clc								; Clear carry flag.
	adc trackn_tablenote,x			;here as a frequency
	jmp cmd5ax
	EIF		;FEAT_TABLETYPE
cmd5a1
	lda trackn_note,x
	clc
	adc trackn_tablenote,x
	cmp #61
	bcc cmd5a2						;ok 0-60 => branch
	lda #63
cmd5a2
	tay
	lda (nr),y
cmd5ax
	sta trackn_portafrqc,x			;target portamento frq
	ldy reg3						;=00?
	bne cmd5a						;no => branch
	sta trackn_portafrqa,x			;current portamento frq
cmd5a
	tya
	lsr @
	lsr @
	lsr @
	lsr @
	sta trackn_portaspeed,x
	sta trackn_portaspeeda,x
	lda reg3
	and #$0f
	sta trackn_portadepth,x
	lda trackn_note,x
	jmp cmd0a
	ELI FEAT_COMMAND5
;	command 5 is present, but portamento is never used
;	jmp pp9					;<--this was not quite right (caused a spike at tone start)
	lda trackn_note,x		;behaves like a standard command 0
	jmp cmd0a				;without shifting the note by the parameter
	EIF
;~~~~~~~~
cmd6	;filtershiftfrq = filtershiftfrq + FRQ_n
	IFT FEAT_COMMAND6&&FEAT_FILTER
	lda reg3
	clc
	adc trackn_filter,x
	sta trackn_filter,x
	lda trackn_note,x
	jmp cmd0a
	ELI FEAT_COMMAND6
;	command 6 is present, but the filter is never used
;	jmp pp9					;<--this is not quite right either
	lda trackn_note,x		;behaves like a standard command 0
	jmp cmd0a				;without shifting the note by the parameter
	EIF	
;~~~~~~~~
cmd7	;NOTE = NOTE_n		;play CMD 0 00
	IFT FEAT_COMMAND7SETNOTE||FEAT_COMMAND7VOLUMEONLY
	IFT FEAT_COMMAND7SETNOTE
	lda reg3
	IFT FEAT_COMMAND7VOLUMEONLY
	cmp #$80				;$80 => volume only?
	beq cmd7a
	EIF
	sta trackn_note,x
	jmp cmd0a
	EIF
	IFT FEAT_COMMAND7VOLUMEONLY
cmd7a
	lda trackn_audc,x
	ora #$f0				;111 1 vvvv
	sta trackn_audc,x
	lda trackn_note,x
	jmp cmd0a
	EIF
	EIF

;cmd0 comes last of the commands as an optimization, so it can continue straight to pp9
cmd0	;play NOTE + NOTE_n		[+shiftfrq]
	lda trackn_note,x
	clc
	adc reg3
cmd0a
	IFT FEAT_TABLETYPE
	ldy trackn_tabletypespeed,x	;type? (the top bit decides)
	bmi cmd0b					;=$80 => frequency => branch
	EIF
	clc
	adc trackn_tablenote,x		;table note shift
	cmp #61						;note range 0-60 (60 included)
	bcc cmd0a1					;ok (0-60) => branch
	lda #0
	sta trackn_audc,x			;silence
	lda #63						;more than 60 => note 63
cmd0a1
	IFT FEAT_BASS16
	sta trackn_outnote,x		;resulting note
	EIF
	tay
	lda (nr),y					;note frequency table
	clc
	adc trackn_shiftfrq,x
	IFT FEAT_COMMAND2
	clc
	adc frqaddcmd2				;possible shift by command 2
	EIF
;	sta trackn_audf,x			;store into audf;  OPTIMIZATION: moved down after cmd0c
	IFT FEAT_TABLETYPE		
	jmp cmd0c					;OPTIMIZATION: after cmd0c it does sta trackn_audf,x and continues straight on without the jump to pp9
cmd0b
	cmp #61						;note range 0-60
	bcc cmd0b1					;ok (0-60) => branch
	lda #0
	sta trackn_audc,x			;silence
	lda #63						;more than 60 => note 63
cmd0b1
	tay
	lda trackn_shiftfrq,x
	clc
	adc trackn_tablenote,x		;here as a frequency
	clc
	adc (nr),y					;note frequency table
	IFT FEAT_COMMAND2
	clc
	adc frqaddcmd2				;possible shift by command 2
	EIF
;	sta trackn_audf,x			;OPTIMIZATION: moved a bit lower after cmd0c
;	jmp pp9						;OPTIMIZATION: continues straight on (through cmd0c)
	EIF		;/FEAT_TABLETYPE
;~~~~~~~~ CAUTION! not terminated, continues on (the jmp pp9 was removed)
cmd0c
	sta trackn_audf,x			;store into audf
;and continues on
pp9
;portamento effect processing
	IFT FEAT_PORTAMENTO
		lda trackn_portaspeeda,x	; Is the portamento effect curently active?
		beq pp10					; If $00, it is not active, so skip.
		dec trackn_portaspeeda,x	; Decrease the value by 1.
		bne pp10					; If not $00, it is still active, so skip.
		lda trackn_portaspeed,x		; portamento speed in memory
		sta trackn_portaspeeda,x	; overwrite the current portamento speed value to reset it
		lda trackn_portafrqa,x		; current portamento frequency in memory
		cmp trackn_portafrqc,x		; Compare current portamento frequency to target frequency
		beq pp10					; If equal, portamento is done and can be skipped
		bcs pps1					; If the current portamento pitch is higher, branch to pps1
;current portamento frq < target
	adc trackn_portadepth,x			;current porta frq += depth
	bcs pps8						;the addition overflowed past 255 => branch
	cmp trackn_portafrqc,x			;compare with the target porta frq
	bcs pps8						;after the addition it is already >= => branch
	jmp pps9						;after the addition it is still smaller
pps1
;current porta frq > target
	sbc trackn_portadepth,x			;current porta frq -= depth
	bcc pps8						;the subtraction underflowed below 0 => branch
	cmp trackn_portafrqc,x			;compare with the target porta frq
	bcs pps9						;after the subtraction it is still >=
									;after the subtraction it is already smaller
pps8
	lda trackn_portafrqc,x
pps9
	sta trackn_portafrqa,x
pp10
;
	lda reg2
	and #$01						;portamento bit 0000 000s
	beq pp11						;=0 => branch
	lda trackn_portafrqa,x
	clc
	adc trackn_shiftfrq,x			;portamento is affected by shifting too
	sta trackn_audf,x
pp11
	EIF
;
ppnext								;jumped to when the instrument is not initialized
	dex								;OPTIMIZATION (x--)
	bmi rmt_p4						;OPTIMIZATION
	jmp pp1

rmt_p4
;------------------------------------------------------------------------------------------
;first puts the AUDCTL together
	IFT FEAT_AUDCTLMANUALSET
	lda trackn_audctl+0		;always only TRACKS 0-3 (for POKEY 1)
	ora trackn_audctl+1
	ora trackn_audctl+2
	ora trackn_audctl+3
	tax
	ELS
	ldx #0					;without FEAT_AUDCTLMANUALSET, sets X=0 directly
	EIF
qq1
	stx v_audctl			;finished audctl -> initializes v_audctl (compared later for the filter's priority over 16-bit bass)
;additional operations for filters and 16-bit bass
;filters
	IFT FEAT_FILTER
	IFT FEAT_FILTERG0L
	lda trackn_command+0	;track0
	bpl qq2					;top bit==0 => no filtering
	lda trackn_audc+0		;take audc
	and #$0f				;volume 0-15 only
	beq qq2					;zero => no filtering
	;with filtering
	lda trackn_audf+0		;frequency of g0
	clc
	adc trackn_filter+0		;shift for filtering
	sta trackn_audf+2		;g0 is filtered through g2
	IFT FEAT_COMMAND7VOLUMEONLY&&FEAT_VOLUMEONLYG2L
	lda trackn_audc+2		;g2 volume state?
	and #$10				;volume only?
	bne qq1a				;yes => branch
	EIF
	lda #0
	sta trackn_audc+2		;g2 gets zero volume
qq1a
	txa
	ora #4					;bit2 audctl (filter g0-g2)
	tax
	EIF		;FEAT_FILTERG0L

qq2
	IFT FEAT_FILTERG1L
	lda trackn_command+1	;track1
	bpl qq3					;top bit==0 => no filtering
	lda trackn_audc+1		;take audc
	and #$0f				;volume 0-15 only
	beq qq3					;zero => no filtering
	;with filtering
	lda trackn_audf+1		;frequency of g1
	clc
	adc trackn_filter+1		;shift for filtering
	sta trackn_audf+3		;g1 is filtered through g3
	IFT FEAT_COMMAND7VOLUMEONLY&&FEAT_VOLUMEONLYG3L	
	lda trackn_audc+3		;g3 volume state?
	and #$10				;volume only?
	bne qq2a				;yes => branch
	EIF
	lda #0
	sta trackn_audc+3		;g3 gets zero volume
qq2a
	txa
	ora #2					;bit1 audctl (filter g1-g3)
	tax
	EIF		;FEAT_FILTERG1L
qq3
	IFT FEAT_FILTERG0L||FEAT_FILTERG1L
	cpx v_audctl			;did it change? (is filter g0-g2 or g1-g3 active)?
	bne qq5					;yes => branch (no 16-bit bass then)
	EIF
	EIF		;FEAT_FILTER
;16-bit bass
	IFT FEAT_BASS16
	IFT FEAT_BASS16G1L	
	lda trackn_command+1	;track1
	and #$0e				;0000 ddd0
	cmp #6					;type 6 => 16-bit bass
	bne qq4
	lda trackn_audc+1		;take audc
	and #$0f				;volume 0-15 only
	beq qq4					;zero => no 16-bit bass
	ldy trackn_outnote+1
	lda frqtabbasslo,y
	sta trackn_audf+0		;lo g0
	lda frqtabbasshi,y
	sta trackn_audf+1		;hi g1
	IFT FEAT_COMMAND7VOLUMEONLY&&FEAT_VOLUMEONLYG0L	
	lda trackn_audc+0		;g0 volume state?
	and #$10				;volume only?
	bne qq3a				;yes => branch
	EIF
	lda #0
	sta trackn_audc+0		;g0 gets zero volume
qq3a
	txa
	ora #$50				;joins g0-g1 16-bit
	tax
	EIF		;FEAT_BASS16G1L
qq4
	IFT FEAT_BASS16G3L
	lda trackn_command+3	;track3
	and #$0e				;0000 ddd0
	cmp #6					;type 6 => 16-bit bass
	bne qq5
	lda trackn_audc+3		;take audc
	and #$0f				;volume 0-15 only
	beq qq5					;zero => no 16-bit bass
	ldy trackn_outnote+3
	lda frqtabbasslo,y
	sta trackn_audf+2		;lo g2
	lda frqtabbasshi,y
	sta trackn_audf+3		;hi g3
	IFT FEAT_COMMAND7VOLUMEONLY&&FEAT_VOLUMEONLYG2L	
	lda trackn_audc+2		;g2 volume state?
	and #$10				;volume only?
	bne qq4a				;yes => branch
	EIF
	lda #0
	sta trackn_audc+2		;g2 gets zero volume
qq4a
	txa
	ora #$28				;joins g2-g3 16-bit
	tax
	EIF		;FEAT_BASS16G3L	
	EIF		;FEAT_BASS16
qq5
;
	stx v_audctl
;
	IFT TRACKS>4
;the same, in the variant for the second POKEY
;first puts the AUDCTL together
	IFT FEAT_AUDCTLMANUALSET
	lda trackn_audctl+4		;always only TRACKS 4-7 (for POKEY 2)
	ora trackn_audctl+5
	ora trackn_audctl+6
	ora trackn_audctl+7
	tax
	ELS
	ldx #0					;without FEAT_AUDCTLMANUALSET, sets X=0 directly
	EIF
	stx v_audctl2			;finished audctl2 -> initializes v_audctl (compared later for the filter's priority over 16-bit bass)
;additional operations for filters and 16-bit bass
;filters
	IFT FEAT_FILTER
	IFT FEAT_FILTERG0R
	lda trackn_command+0+4	;track0R
	bpl qs2					;top bit==0 => no filtering
	lda trackn_audc+0+4		;take audc
	and #$0f				;volume 0-15 only
	beq qs2					;zero => no filtering
	;with filtering
	lda trackn_audf+0+4		;frequency of g0R
	clc
	adc trackn_filter+0+4	;shift for filtering
	sta trackn_audf+2+4		;g0R is filtered through g2R
	IFT FEAT_COMMAND7VOLUMEONLY&&FEAT_VOLUMEONLYG2R
	lda trackn_audc+2+4		;g2R volume state?
	and #$10				;volume only?
	bne qs1a				;yes => branch
	EIF
	lda #0
	sta trackn_audc+2+4		;g2R gets zero volume
qs1a
	txa
	ora #4					;bit2 audctl (filter g0-g2)
	tax
	EIF		;FEAT_FILTERG0R
qs2
	IFT FEAT_FILTERG1R
	lda trackn_command+1+4	;track1R
	bpl qs3					;top bit==0 => no filtering
	lda trackn_audc+1+4		;take audc
	and #$0f				;volume 0-15 only
	beq qs3					;zero => no filtering
	;with filtering
	lda trackn_audf+1+4		;frequency of g1R
	clc
	adc trackn_filter+1+4	;shift for filtering
	sta trackn_audf+3+4		;g1R is filtered through g3R
	IFT FEAT_COMMAND7VOLUMEONLY&&FEAT_VOLUMEONLYG3R
	lda trackn_audc+3+4		;g3R volume state?
	and #$10				;volume only?
	bne qs2a				;yes => branch
	EIF
	lda #0
	sta trackn_audc+3+4		;g3R gets zero volume
qs2a
	txa
	ora #2					;bit1 audctl (filter g1-g3)
	tax
	EIF		;FEAT_FILTERG1R
qs3
	IFT FEAT_FILTERG0R||FEAT_FILTERG1R
	cpx v_audctl2			;did it change? (is filter g0R-g2R or g1R-g3R active)?
	bne qs5					;yes => branch (no 16-bit bass then)
	EIF
	EIF		;FEAT_FILTER
;16-bit bass
	IFT FEAT_BASS16
	IFT FEAT_BASS16G1R
	lda trackn_command+1+4	;track1R
	and #$0e				;0000 ddd0
	cmp #6					;type 6 => 16-bit bass
	bne qs4
	lda trackn_audc+1+4		;take audc
	and #$0f				;volume 0-15 only
	beq qs4					;zero => no 16-bit bass
	ldy trackn_outnote+1+4
	lda frqtabbasslo,y
	sta trackn_audf+0+4		;lo g0R
	lda frqtabbasshi,y
	sta trackn_audf+1+4		;hi g1R
	IFT FEAT_COMMAND7VOLUMEONLY&&FEAT_VOLUMEONLYG0R
	lda trackn_audc+0+4		;g0R volume state?
	and #$10				;volume only?
	bne qs3a				;yes => branch
	EIF
	lda #0
	sta trackn_audc+0+4		;g0R gets zero volume
qs3a
	txa
	ora #$50				;joins g0-g1 16-bit
	tax
	EIF		;FEAT_BASS16G1R
qs4
	IFT FEAT_BASS16G3R
	lda trackn_command+3+4	;track3R
	and #$0e				;0000 ddd0
	cmp #6					;type 6 => 16-bit bass
	bne qs5
	lda trackn_audc+3+4		;take audc
	and #$0f				;volume 0-15 only
	beq qs5					;zero => no 16-bit bass
	ldy trackn_outnote+3+4
	lda frqtabbasslo,y
	sta trackn_audf+2+4		;lo g2R
	lda frqtabbasshi,y
	sta trackn_audf+3+4		;hi g3R
	IFT FEAT_COMMAND7VOLUMEONLY&&FEAT_VOLUMEONLYG2R
	lda trackn_audc+2+4		;g2R volume state?
	and #$10				;volume only?
	bne qs4a				;yes => branch
	EIF
	lda #0
	sta trackn_audc+2+4		;g2R gets zero volume
qs4a
	txa
	ora #$28				;joins g2-g3 16-bit
	tax
	EIF		;FEAT_BASS16G3R
	EIF		;FEAT_BASS16
qs5
;
	stx v_audctl2			;R
	EIF
;
;
rmt_p5
;------------------------------------------------------------------------------------------
	IFT FEAT_INSTRSPEED==0||FEAT_INSTRSPEED>1
	lda #$ff			;the parameter is self-modified   v_ainstrspeed	;returns the actual instrument speed (for X vbi, countdown X to 1)
v_ainstrspeed equ *-1
	ELS
	lda #1					;for instrspeed 1 always returns #1
	EIF
	rts
;	END
;
;
;
;
;
;
;
;==========================================================================================
SetPokey
;
	IFT STEREOMODE==1		;* L1 L2 L3 L4 R1 R2 R3 R4
;write to the two POKEYs, stereo (always the right register first, then immediately the left)
	ldy #$ff				; The parameter is self-modified
v_audctl2 equ *-1
;AUDF0
	lda trackn_audf+0+4
	ldx trackn_audf+0
	sta $d210
	stx $d200
;AUDC0
	lda trackn_audc+0+4
	ldx trackn_audc+0
	sta $d211
	stx $d201
;AUDF1
	lda trackn_audf+1+4
	ldx trackn_audf+1
	sta $d212
	stx $d202
;AUDC1
	lda trackn_audc+1+4
	ldx trackn_audc+1
	sta $d213
	stx $d203
;AUDF2
	lda trackn_audf+2+4
	ldx trackn_audf+2
	sta $d214
	stx $d204
;AUDC2
	lda trackn_audc+2+4
	ldx trackn_audc+2
	sta $d215
	stx $d205
;AUDF3
	lda trackn_audf+3+4
	ldx trackn_audf+3
	sta $d216
	stx $d206
;AUDC3
	lda trackn_audc+3+4
	ldx trackn_audc+3
	sta $d217
	stx $d207
;AUDCTL
	lda #$ff				; The parameter is self-modified
v_audctl equ *-1
	sty $d218				;Y was set a while above
	sta $d208
;
	ELI STEREOMODE==0		;* L1 L2 L3 L4
;write to the POKEY, mono - left side only
;
	ldy #$ff				;the parameter is self-modified
v_audctl equ *-1
;
	lda trackn_audf+0
	ldx trackn_audc+0
	sta $d200
	stx $d201
;
	lda trackn_audf+1
	ldx trackn_audc+1
	sta $d200+2
	stx $d201+2
;
	lda trackn_audf+2
	ldx trackn_audc+2
	sta $d200+4
	stx $d201+4
;
	lda trackn_audf+3
	ldx trackn_audc+3
	sta $d200+6
	stx $d201+6
;
	sty $d208
;
	ELI STEREOMODE==2		;* L1 R2 R3 L4

	ldy #$ff				;the parameter is self-modified
v_audctl equ *-1

	lda trackn_audf+0
	ldx trackn_audc+0
	sta $d200
	stx $d201
	sta $d210				;the frequency into the right one too (in case R2 plays 16-bit bass 2+1)

	lda trackn_audf+1
	ldx trackn_audc+1
	sta $d210+2
	stx $d211+2

	lda trackn_audf+2
	ldx trackn_audc+2
	sta $d210+4
	stx $d211+4
	sta $d200+4				;the frequency into the left one too (in case L1 plays filter 1+3 or L4 plays 16-bit bass 4+3)

	lda trackn_audf+3
	ldx trackn_audc+3
	sta $d200+6
	stx $d201+6
	sta $d210+6				;the frequency into the right one too (in case R2 plays filter 2+4)

	sty $d218
	sty $d208

	ELI STEREOMODE==3		;* L1 L2 R3 R4
;write for L1 L2 R3 R4
;
	ldy #$ff				;the parameter is self-modified
v_audctl equ *-1
;
	lda trackn_audf+0
	ldx trackn_audc+0
	sta $d200
	stx $d201

	lda trackn_audf+1
	ldx trackn_audc+1
	sta $d200+2
	stx $d201+2

	lda trackn_audf+2
	ldx trackn_audc+2
	sta $d210+4
	stx $d211+4
	sta $d200+4				;the frequency into the left one too (in case L1 plays filter 1+3)

	lda trackn_audf+3
	ldx trackn_audc+3
	sta $d210+6
	stx $d211+6
	sta $d200+6				;the frequency into the left one too (in case L2 plays filter 2+4)

	sty $d218
	sty $d208

	EIF

	rts

;---------------------------------------------------------------------------------------------------------------------------------------------;

RMTPLAYEREND


