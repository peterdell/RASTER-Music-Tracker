;
;	RMT_SAP4
;
STEREOMODE	equ 0			; To assemble RMT for 4 tracks mono
	icl "rmt.a65"

MODUL equ $4000
;
	org $394e				; $3961	;$3965		;$395f		;$3987		;$399d		;$39a0
start
	ert start!=RMTPLAYEREND	; The SAP4 init routine does not follow immediately after the RMT routine
							; MUST FIX, AND CAUTION - THE SAP ROUTINE'S START ADDRESS IS STATED IN THE C CODE INSIDE RMT TRACKER
;
	tax						; CAUTION: the tracker overwrites the first 4 bytes with instructions
	lda subsongs,x			; Song line 0-255	;NOP NOP LDA#value     if there are no multiple subsongs
	ldx #<MODUL
	ldy #>MODUL
	jmp RASTERMUSICTRACKER	; jsrrts!
							; sta vbinspeed			;how many times to call per 1 vbi
							; rts
;
subsongs
; CAUTION: the tracker appends the possible subsong positions here
; So if this routine's length changes, the tracker must be adjusted:
; at the start of the routine int CSong::Export the value
; int adr_subsongs = adr_init+11;
